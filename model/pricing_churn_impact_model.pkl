import pandas as pdimport numpy as npfrom sklearn.linear_model import LogisticRegression# -----------------------------# 1?? Load modeling dataset# -----------------------------df = pd.read_csv("Data/processed/pricing_model_df.csv")# -----------------------------# 2?? Separate target# -----------------------------y = df["churned"]X_raw = df.drop(columns=["churned"])# -----------------------------# 3?? One-hot encode pricing features# -----------------------------X = pd.get_dummies(    X_raw,    drop_first=True  # avoids dummy trap)# -----------------------------# 4?? Train Logistic Regression# -----------------------------model = LogisticRegression(max_iter=1000)model.fit(X, y)# -----------------------------# 5?? Extract coefficients# -----------------------------coef_df = pd.DataFrame({    "feature": X.columns,    "log_odds_coef": model.coef_[0]})# -----------------------------# 6?? Convert log-odds ? churn delta %# -----------------------------baseline_prob = y.mean()def log_odds_to_prob_delta(coef, base):    odds = np.exp(coef)    new_prob = odds * base / (1 + base * (odds - 1))    return new_prob - basecoef_df["churn_delta"] = coef_df["log_odds_coef"].apply(    lambda x: log_odds_to_prob_delta(x, baseline_prob))coef_df["churn_delta_pct"] = (coef_df["churn_delta"] * 100).round(2)# -----------------------------# 7?? Risk buckets (interpretation layer)# -----------------------------def risk_bucket(x):    if x > 3:        return "High Risk"    elif x > 1:        return "Moderate Risk"    elif x < -2:        return "Protective"    else:        return "Neutral"coef_df["risk_bucket"] = coef_df["churn_delta_pct"].apply(risk_bucket)coef_df = coef_df.sort_values("churn_delta_pct", ascending=False)# -----------------------------# 8?? Save final model output# -----------------------------coef_df.to_csv(    "Data/processed/pricing_churn_impact.csv",    index=False)