import pandas as pd
import numpy as np
import prepstack

account = pd.read_csv("C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\raw\\ravenstack_accounts.csv")
subs_info = pd.read_csv("C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\raw\\ravenstack_subscriptions.csv")
churn_info = pd.read_csv("C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\raw\\ravenstack_churn_events.csv")
usage_info = pd.read_csv("C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\raw\\ravenstack_feature_usage.csv")
support_info = pd.read_csv("C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\raw\\ravenstack_support_tickets.csv")

d1 = pd.merge(account,subs_info , on ='account_id' , how = 'left')
d2 = d1[['account_id','subscription_id','start_date', 'end_date', 'account_name', 'mrr_amount', 'arr_amount','industry', 'country', 'signup_date','referral_source','plan_tier_y', 'seats_y','is_trial_y' , 'churn_flag_y','upgrade_flag', 'downgrade_flag','billing_frequency','auto_renew_flag']]
d2.to_csv("subscription_base.csv")
d3 = pd.merge(d2,churn_info , on ='account_id' , how = 'left')
d4 = pd.merge(d3,support_info , on ='account_id' , how = 'left')
d5 = pd.merge(d4,usage_info , on ='subscription_id' , how = 'left')

# -------------------------------
# 1. df_usage 
# -------------------------------
usage_cols = [
    "subscription_id",
    "start_date",
    "end_date",
    "usage_date",
    "feature_name",
    "usage_count",
    "usage_duration_secs",
    "is_beta_feature"
]

df_usage = d5[usage_cols].copy()

# -------------------------------
# 2. Datetime conversion
# -------------------------------
df_usage["start_date"] = pd.to_datetime(df_usage["start_date"])
df_usage["end_date"] = pd.to_datetime(df_usage["end_date"])
df_usage["usage_date"] = pd.to_datetime(df_usage["usage_date"])

# -------------------------------
# 3. Filter usage within subscription window
# -------------------------------
df_usage = df_usage[
    (df_usage["usage_date"] >= df_usage["start_date"]) &
    (
        df_usage["end_date"].isna() |
        (df_usage["usage_date"] <= df_usage["end_date"])
    )
].copy()

# -------------------------------
# 4. Early usage flags
# -------------------------------
df_usage["days_since_start"] = (
    df_usage["usage_date"] - df_usage["start_date"]
).dt.days

df_usage["is_first_30_days"] = df_usage["days_since_start"] <= 30

df_usage["usage_count_first_30"] = np.where(
    df_usage["is_first_30_days"],
    df_usage["usage_count"],
    0
)

df_usage["usage_duration_first_30"] = np.where(
    df_usage["is_first_30_days"],
    df_usage["usage_duration_secs"],
    0
)

# -------------------------------
# 5. Aggregate per subscription
# -------------------------------
usage_agg = (
    df_usage
    .groupby("subscription_id", as_index=False)
    .agg(
        total_usage_events=("usage_count", "sum"),
        total_usage_duration_secs=("usage_duration_secs", "sum"),
        unique_features_used=("feature_name", "nunique"),
        beta_feature_usage_rate=("is_beta_feature", "mean"),
        usage_events_first_30_days=("usage_count_first_30", "sum"),
        usage_duration_first_30_days=("usage_duration_first_30", "sum")
    )
)

# -------------------------------
# 6. Sanity check
# -------------------------------
assert usage_agg["subscription_id"].is_unique

subscription_base = d2.drop_duplicates("subscription_id")
usage_agg.to_csv("usage_aggregated.csv")

assert subscription_base["subscription_id"].is_unique

subscription_with_usage = subscription_base.merge(
    usage_agg,
    on="subscription_id",
    how="left"
)

subscription_with_usage.fillna(
    {
        "total_usage_events": 0,
        "total_usage_duration_secs": 0,
        "unique_features_used": 0,
        "beta_feature_usage_rate": 0,
        "usage_events_first_30_days": 0,
        "usage_duration_first_30_days": 0
    },
    inplace=True
)

assert subscription_with_usage["subscription_id"].is_unique

#print(subscription_with_usage)

# -------------------------------
# SUPPORT TICKETS AGGREGATION
# -------------------------------

support_cols = [
    "subscription_id",
    "ticket_id",
    "submitted_at",
    "closed_at",
    "resolution_time_hours",
    "first_response_time_minutes",
    "satisfaction_score",
    "escalation_flag"
]

# Build support df from d5
df_support = d5[support_cols].copy()

# Datetime safety
df_support["submitted_at"] = pd.to_datetime(df_support["submitted_at"])
df_support["closed_at"] = pd.to_datetime(df_support["closed_at"])

# Aggregate per subscription
support_agg = (
    df_support
    .groupby("subscription_id", as_index=False)
    .agg(
        total_tickets=("ticket_id", "nunique"),
        avg_satisfaction_score=("satisfaction_score", "mean"),
        escalation_rate=("escalation_flag", "mean"),
        avg_resolution_time_hours=("resolution_time_hours", "mean"),
        avg_first_response_time_minutes=("first_response_time_minutes", "mean")
    )
)

assert support_agg["subscription_id"].is_unique
#support_agg.head()
support_agg.to_csv("support_aggregated.csv")
# -------------------------------
# CHURN AGGREGATION
# -------------------------------

churn_cols = [
    "subscription_id",
    "churn_event_id",
    "churn_date",
    "reason_code",
    "refund_amount_usd",
    "preceding_upgrade_flag",
    "preceding_downgrade_flag",
    "is_reactivation"
]

df_churn = d5[churn_cols].copy()

df_churn["churn_date"] = pd.to_datetime(df_churn["churn_date"])

# Aggregate per subscription
churn_agg = (
    df_churn
    .groupby("subscription_id", as_index=False)
    .agg(
        churned=("churn_event_id", lambda x: x.notna().any()),
        churn_date=("churn_date", "max"),
        churn_reason=("reason_code", "last"),
        refund_amount_usd=("refund_amount_usd", "sum"),
        churn_after_upgrade=("preceding_upgrade_flag", "max"),
        churn_after_downgrade=("preceding_downgrade_flag", "max"),
        reactivated=("is_reactivation", "max")
    )
)

assert churn_agg["subscription_id"].is_unique
#churn_agg.head()
churn_agg.to_csv("churn_aggregated.csv")

pricing_lifecycle = (
    subscription_with_usage
    .merge(support_agg, on="subscription_id", how="left")
    .merge(churn_agg, on="subscription_id", how="left")
)

assert pricing_lifecycle["subscription_id"].is_unique
pricing_lifecycle.to_csv("pricing_lifecycle.csv")
