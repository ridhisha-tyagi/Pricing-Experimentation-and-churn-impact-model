import pandas as pd
import numpy as np
from sklearn.linear_model import LogisticRegression

# -----------------------------
# 1️⃣ Select modeling columns
# -----------------------------
model_df = df[
    [
        "churned",
        "trial_group",
        "billing_group",
        "plan_group",
        "seat_bucket"
    ]
].copy()

# -----------------------------
# 2️⃣ Force meaningful baselines
# -----------------------------
model_df["trial_group"] = pd.Categorical(
    model_df["trial_group"],
    categories=["Non-Trial", "Trial"],
    ordered=True
)

model_df["billing_group"] = pd.Categorical(
    model_df["billing_group"],
    categories=["Monthly", "Annual"],
    ordered=True
)

model_df["plan_group"] = pd.Categorical(
    model_df["plan_group"],
    categories=["Enterprise", "Pro", "Basic"],
    ordered=True
)

model_df["seat_bucket"] = pd.Categorical(
    model_df["seat_bucket"],
    categories=["Mid", "Small", "Very Small", "Large"],
    ordered=True
)

# -----------------------------
# 3️⃣ Encode categoricals
# -----------------------------
X = pd.get_dummies(
    model_df.drop(columns="churned"),
    drop_first=True
)

y = model_df["churned"].astype(int)

# -----------------------------
# 4️⃣ Fit logistic model
# -----------------------------
model = LogisticRegression(
    max_iter=1000,
    solver="lbfgs"
)

model.fit(X, y)

# -----------------------------
# 5️⃣ Convert coefficients → churn impact
# -----------------------------
coef_df = pd.DataFrame({
    "feature": X.columns,
    "log_odds_coef": model.coef_[0]
})

coef_df["churn_delta"] = coef_df["log_odds_coef"].apply(
    lambda x: 1 / (1 + np.exp(-x)) - 0.5
)

coef_df["churn_delta_pct"] = (coef_df["churn_delta"] * 100).round(2)

# -----------------------------
# 6️⃣ Risk buckets (business-readable)
# -----------------------------
def risk_bucket(delta):
    if delta > 0.03:
        return "High Risk"
    elif delta > 0.015:
        return "Moderate Risk"
    elif delta < -0.015:
        return "Protective"
    else:
        return "Neutral"

coef_df["risk_bucket"] = coef_df["churn_delta"].apply(risk_bucket)

coef_df.sort_values(
    "churn_delta_pct",
    ascending=False
).reset_index(drop=True


from prepstack.visualizations.preview import preview_theme
import matplotlib.pyplot as plt
