import prepstack
import pandas as pd

df = pd.read_csv(
    "C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\processed\\pricing_lifecycle.csv"
)

# 1️⃣ Dataset overview (structure)
from prepstack.explore.overview import dataset_overview
dataset_overview(df)

# 2️⃣ High-level overview insights (TEXT ONLY)
from prepstack.explore.overview import overview_insights
overview_insights(df)

# 3️⃣ Missing summary (DATAFRAME)
from prepstack.explore.missing import missing_report
missing_df = missing_report(df)
missing_df.head()

# 4️⃣ Missing insights (TEXT ONLY)
from prepstack.explore.missing import missing_insights
missing_insights(missing_df)

from prepstack.cleaning.types import clean_types


schema = {
    "start_date": "datetime",
    "end_date": "datetime",
    "signup_date": "datetime",
    "churn_date": "datetime"
}

df = clean_types(df, schema=schema)

from prepstack.cleaning.missing import fill_missing_numeric

zero_fill_cols = [
    "total_usage_events",
    "usage_events_first_30_days",
    "total_usage_duration_secs",
    "usage_duration_first_30_days",
    "refund_amount_usd",
    "total_tickets"
]

df = fill_missing_numeric(
    df,
    columns=zero_fill_cols,
    strategy="zero"
)

from prepstack.cleaning.missing import fill_missing_categorical

cat_cols = [
    "referral_source",
    "industry",
    "plan_tier_y"
]

df = fill_missing_categorical(
    df,
    columns=cat_cols,
    strategy="unknown"
)

df.isna().sum().sort_values(ascending=False)

df["activated_early"] = (df["usage_events_first_30_days"] > 0).astype(int)

df["activation_intensity"] = (
    df["usage_events_first_30_days"] /
    (df["total_usage_events"] + 1)
)

df["mrr_per_seat"] = df["mrr_amount"] / df["seats_y"]

df["usage_per_seat"] = df["total_usage_events"] / df["seats_y"]

df["value_efficiency"] = (
    df["total_usage_events"] /
    (df["mrr_amount"] + 1)
)

df["tickets_per_month"] = (
    df["total_tickets"] /
    ((df["end_date"].fillna(pd.Timestamp.today()) - df["start_date"]).dt.days / 30 + 1)
)

df["subscription_age_days"] = (
    df["end_date"].fillna(pd.Timestamp.today()) - df["start_date"]
).dt.days

df["days_to_churn"] = (
    df["churn_date"] - df["start_date"]
).dt.days

df["is_annual"] = (df["billing_frequency"] == "annual").astype(int)
df["is_enterprise"] = (df["plan_tier_y"] == "Enterprise").astype(int)
df["is_paid"] = (df["mrr_amount"] > 0).astype(int)

df[
    [
        "activated_early",
        "mrr_per_seat",
        "usage_per_seat",
        "value_efficiency",
        "subscription_age_days"
    ]
].describe()