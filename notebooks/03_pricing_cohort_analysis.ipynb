import prepstack
import pandas as pd
import numpy as np

df = pd.read_csv(
    "C:\\Users\\Lenovo\\OneDrive\\Desktop\\Experimentation & Pricing System\\Data\\processed\\pricing_lifecycle_02.csv"
)

#1. Split 1 (Trial vs Non-Trial)

df["trial_group"] = np.where(df["is_trial_y"], "Trial", "Non-Trial")

trial_outcomes = (
    df
    .groupby("trial_group")
    .agg(
        subs=("subscription_id", "count"),
        churn_rate=("churned", "mean"),
        churn_after_upgrade_rate=("churn_after_upgrade", "mean"),
        churn_after_downgrade_rate=("churn_after_downgrade", "mean"),
        median_subscription_age=("subscription_age_days", "median")
    )
    .reset_index()
)

trial_outcomes

#2. Split: Billing Frequency (Monthly vs Annual)

df["billing_group"] = df["billing_frequency"].str.title()

billing_outcomes = (
    df
    .groupby(["trial_group", "billing_group"])
    .agg(
        subs=("subscription_id", "count"),
        churn_rate=("churned", "mean"),
        churn_after_upgrade_rate=("churn_after_upgrade", "mean"),
        churn_after_downgrade_rate=("churn_after_downgrade", "mean"),
        median_subscription_age=("subscription_age_days", "median")
    )
    .reset_index()
)

billing_outcomes

#3.) Split: Plan Tier

df["plan_group"] = df["plan_tier_y"].str.title()

plan_outcomes = (
    df
    .groupby(["trial_group", "billing_group", "plan_group"])
    .agg(
        subs=("subscription_id", "count"),
        churn_rate=("churned", "mean"),
        churn_after_upgrade_rate=("churn_after_upgrade", "mean"),
        churn_after_downgrade_rate=("churn_after_downgrade", "mean"),
        median_subscription_age=("subscription_age_days", "median")
    )
    .reset_index()
)

plan_outcomes

#4.) Split: seat Tier

df["seat_bucket"] = pd.cut(
    df["seats_y"],
    bins=[0, 5, 20, 100, df["seats_y"].max()],
    labels=["Very Small", "Small", "Mid", "Large"]
)

seat_outcomes = (
    df
    .groupby(
        ["trial_group", "billing_group", "plan_group", "seat_bucket"]
    )
    .agg(
        subs=("subscription_id", "count"),
        churn_rate=("churned", "mean"),
        churn_after_upgrade_rate=("churn_after_upgrade", "mean"),
        churn_after_downgrade_rate=("churn_after_downgrade", "mean"),
        median_subscription_age=("subscription_age_days", "median")
    )
    .reset_index()
)

seat_outcomes

rate_cols = [
    "churn_rate",
    "churn_after_upgrade_rate",
    "churn_after_downgrade_rate"
]

for col in rate_cols:
    seat_outcomes[col] = pd.to_numeric(
        seat_outcomes[col],
        errors="coerce"
    )

seat_stats = (
    df
    .groupby(
        ["trial_group", "billing_group", "plan_group", "seat_bucket"]
    )["seats_y"]
    .median()
    .rename("median_seats")
    .reset_index()
)

seat_outcomes = seat_outcomes.merge(
    seat_stats,
    on=["trial_group", "billing_group", "plan_group", "seat_bucket"],
    how="left"
)

final_cols = [
    "trial_group",
    "billing_group",
    "plan_group",
    "seat_bucket",
    "median_seats",
    "subs",
    "churn_rate",
    "churn_after_upgrade_rate",
    "churn_after_downgrade_rate",
    "median_subscription_age"
]

seat_outcomes = seat_outcomes[final_cols]

rate_cols = [
    "churn_rate",
    "churn_after_upgrade_rate",
    "churn_after_downgrade_rate"
]

for col in rate_cols:
    seat_outcomes[col] = pd.to_numeric(seat_outcomes[col], errors="coerce")
    
for col in rate_cols:
    seat_outcomes[col] = (seat_outcomes[col] * 100).round(2)


seat_outcomes

trial_summary = (
    seat_outcomes
    .groupby("trial_group", as_index=False)
    .agg(
        subs=("subs", "sum"),
        avg_churn_rate=("churn_rate", "mean"),
        avg_upgrade_rate=("churn_after_upgrade_rate", "mean"),
        avg_downgrade_rate=("churn_after_downgrade_rate", "mean"),
        median_subscription_age=("median_subscription_age", "median")
    )
)

trial_summary

def assign_trial_label(row, ref):
    # Expansion signal FIRST
    if row["avg_upgrade_rate"] > ref["avg_upgrade_rate"].median():
        return "Expansion-Friendly"
    
    # High stability (quiet retention)
    if (
        row["avg_churn_rate"] < ref["avg_churn_rate"].median()
        and row["median_subscription_age"] > ref["median_subscription_age"].median()
    ):
        return "High Stability"
    
    # Value misalignment
    if row["avg_downgrade_rate"] > ref["avg_downgrade_rate"].median():
        return "Value-Misaligned"
    
    # Risk
    if (
        row["avg_churn_rate"] > ref["avg_churn_rate"].median()
        and row["median_subscription_age"] < ref["median_subscription_age"].median()
    ):
        return "At Risk"
    
    return "Neutral / Mixed"

    
trial_summary["performance_label"] = trial_summary.apply(
    lambda row: assign_trial_label(row, trial_summary),
    axis=1
)

trial_summary

billing_summary = (
    seat_outcomes
    .groupby("billing_group", as_index=False)
    .agg(
        subs=("subs", "sum"),
        avg_churn_rate=("churn_rate", "mean"),
        avg_upgrade_rate=("churn_after_upgrade_rate", "mean"),
        avg_downgrade_rate=("churn_after_downgrade_rate", "mean"),
        median_subscription_age=("median_subscription_age", "median")
    )
)

billing_summary

billing_summary["performance_label"] = billing_summary.apply(
    lambda row: assign_trial_label(row, billing_summary),
    axis=1
)

billing_summary

plan_summary = (
    seat_outcomes
    .groupby("plan_group", as_index=False)
    .agg(
        subs=("subs", "sum"),
        avg_churn_rate=("churn_rate", "mean"),
        avg_upgrade_rate=("churn_after_upgrade_rate", "mean"),
        avg_downgrade_rate=("churn_after_downgrade_rate", "mean"),
        median_subscription_age=("median_subscription_age", "median")
    )
)

plan_summary["performance_label"] = plan_summary.apply(
    lambda row: assign_trial_label(row, plan_summary),
    axis=1
)

plan_summary

plan_seat_summary = (
    seat_outcomes
    .groupby(["plan_group", "seat_bucket"], as_index=False)
    .agg(
        subs=("subs", "sum"),
        avg_churn_rate=("churn_rate", "mean"),
        avg_upgrade_rate=("churn_after_upgrade_rate", "mean"),
        avg_downgrade_rate=("churn_after_downgrade_rate", "mean"),
        median_subscription_age=("median_subscription_age", "median"),
        median_seats=("median_seats", "median")
    )
)

plan_seat_summary["confidence"] = np.where(
    plan_seat_summary["subs"] >= 30,
    "High",
    "Low"
)

def label_within_plan(group):
    ref = group[group["confidence"] == "High"]
    
    if len(ref) == 0:
        group["performance_label"] = "Low Confidence"
        return group
    
    group["performance_label"] = group.apply(
        lambda row: (
            "Low Confidence"
            if row["confidence"] == "Low"
            else assign_trial_label(row, ref)
        ),
        axis=1
    )
    
    return group


plan_seat_labeled = (
    plan_seat_summary
    .groupby("plan_group", group_keys=False)
    .apply(label_within_plan)
)

final_cols = [
    "plan_group",
    "seat_bucket",
    "median_seats",
    "subs",
    "confidence",
    "avg_churn_rate",
    "avg_upgrade_rate",
    "avg_downgrade_rate",
    "median_subscription_age",
    "performance_label"
]

plan_seat_labeled = plan_seat_labeled[final_cols]
plan_seat_labeled